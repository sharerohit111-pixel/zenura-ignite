rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isZenuraAdmin() {
      return request.auth != null
        && request.auth.token.email == "sharerohit111@gmail.com"
        && request.auth.token.email_verified == true;
    }
    match /digital-products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isZenuraAdmin()
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size < 10 * 1024 * 1024)
          ||
          (request.resource.contentType.matches('video/(mp4|webm|quicktime)')
            && request.resource.size < 100 * 1024 * 1024)
        );
      allow delete: if isZenuraAdmin();
    }
  }
}
