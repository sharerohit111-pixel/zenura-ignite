rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isZenuraAdmin() {
      return request.auth != null
        && request.auth.token.email == "sharerohit111@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Customer profiles are private: each customer can access only their own profile.
    // Profile fields never include roles or permissions; admin access remains email-verified only.
    match /customerProfiles/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isZenuraAdmin());
      allow list: if isZenuraAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "email", "displayName", "phone", "createdAt", "updatedAt"])
        && request.resource.data.keys().hasAll(["uid", "email", "displayName", "phone", "createdAt", "updatedAt"])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "phone", "updatedAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Premium entitlement writes are restricted to the verified ZENURA administrator.
    // The QR payment flow requires manual bank-credit verification before activation.
    match /entitlements/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isZenuraAdmin());
      allow create, update: if isZenuraAdmin()
        && request.resource.data.keys().hasOnly([
          "uid", "email", "displayName", "status", "planId", "currentPeriodStart", "currentPeriodEnd",
          "autoRenew", "provider", "paymentId", "approvedBy", "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "uid", "status", "planId", "currentPeriodStart", "currentPeriodEnd",
          "autoRenew", "provider", "updatedAt"
        ])
        && (!("email" in request.resource.data) || request.resource.data.email is string)
        && (!("displayName" in request.resource.data) || request.resource.data.displayName is string)
        && (!("paymentId" in request.resource.data) || request.resource.data.paymentId is string)
        && (!("approvedBy" in request.resource.data) || request.resource.data.approvedBy is string)
        && request.resource.data.uid == uid
        && request.resource.data.status == "premium"
        && request.resource.data.planId in ["month_1", "month_3", "month_6", "year_1"]
        && request.resource.data.currentPeriodStart is timestamp
        && request.resource.data.currentPeriodEnd is timestamp
        && request.resource.data.currentPeriodEnd > request.resource.data.currentPeriodStart
        && request.resource.data.autoRenew == false
        && request.resource.data.provider == "upi_qr_manual"
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // A signed-in customer may submit their own UTR. Only the verified admin can review it.
    match /payments/{paymentId} {
      function validPlan(data) {
        return (data.planId == "month_1" && data.planLabel == "1 Month" && data.amount == 99 && data.days == 30)
          || (data.planId == "month_3" && data.planLabel == "3 Months" && data.amount == 199 && data.days == 90)
          || (data.planId == "month_6" && data.planLabel == "6 Months" && data.amount == 399 && data.days == 180)
          || (data.planId == "year_1" && data.planLabel == "1 Year" && data.amount == 799 && data.days == 365);
      }
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "uid", "email", "displayName", "planId", "planLabel", "amount", "days",
          "utr", "status", "createdAt"
        ])
        && (!("displayName" in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120))
        && request.resource.data.keys().hasAll([
          "uid", "email", "planId", "planLabel", "amount", "days",
          "utr", "status", "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && validPlan(request.resource.data)
        && request.resource.data.utr is string
        && request.resource.data.utr.matches("^[A-Za-z0-9-]{8,40}$")
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
      allow get, list: if isZenuraAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isZenuraAdmin()
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy"])
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedBy == request.auth.token.email
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }
    match /razorpayEvents/{eventId} {
      allow read, write: if false;
    }
    // Indian-market OAuth state, broker credentials and paper-trading records are server-only.
    match /upstoxOAuthStates/{stateId} { allow read, write: if false; }
    match /upstoxConnections/{uid} { allow read, write: if false; }
    match /upstoxConnectionControls/{uid} { allow read, write: if false; }
    match /indianMarketStreamLeases/{uid} { allow read, write: if false; }
    match /indianMarketWorkerState/{workerId} { allow read, write: if false; }
    match /indianMarketWatchlists/{uid} { allow read, write: if false; }
    match /indianPaperAccounts/{uid} { allow read, write: if false; }
    match /indianPaperOrders/{orderId} { allow read, write: if false; }
    match /indianDerivativeOrders/{orderId} { allow read, write: if false; }
    match /indianMarginPreviewLimits/{uid} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Backward-compatible read for accounts whose older admin approvals used nested entitlements.
    match /users/{uid}/private/entitlement {
      allow read: if request.auth != null && (request.auth.uid == uid || isZenuraAdmin());
      allow write: if false;
    }

    // Public business catalogue: visitors can read only while published; only verified admin can write.
    match /publicCatalog/{catalogId} {
      allow get, list: if resource.data.published == true || isZenuraAdmin();
      allow create, update: if isZenuraAdmin()
        && request.resource.data.keys().hasOnly(["categories", "products", "published", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["published", "updatedAt", "updatedBy"])
        && (
          ("categories" in request.resource.data
            && request.resource.data.categories is list
            && request.resource.data.categories.size() <= 30)
          ||
          ("products" in request.resource.data
            && request.resource.data.products is list
            && request.resource.data.products.size() <= 20)
        )
        && request.resource.data.published is bool
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.updatedAt == request.time;
      allow delete: if isZenuraAdmin();
    }


    // Public engagement model settings: only the verified administrator may publish pricing and terms.
    match /publicCatalog/commercialModels {
      allow get, list: if resource.data.published == true || isZenuraAdmin();
      allow create, update: if isZenuraAdmin()
        && request.resource.data.keys().hasOnly(["models", "published", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["models", "published", "updatedAt", "updatedBy"])
        && request.resource.data.models is list
        && request.resource.data.models.size() == 3
        && request.resource.data.published is bool
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.updatedAt == request.time
        && request.resource.data.models[0].keys().hasOnly(["id", "title", "description", "priceLabel", "billingLabel", "features", "active"])
        && request.resource.data.models[1].keys().hasOnly(["id", "title", "description", "priceLabel", "billingLabel", "features", "active"])
        && request.resource.data.models[2].keys().hasOnly(["id", "title", "description", "priceLabel", "billingLabel", "features", "active"]);
      allow delete: if isZenuraAdmin();
    }

    match /enquiries/{enquiryId} {
      // Public website visitors may submit a validated enquiry only.
      allow create: if
        request.resource.data.keys().hasAll([
          "name", "reply", "projectType", "budget", "message", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "reply", "projectType", "budget", "message", "status", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.reply is string
        && request.resource.data.reply.size() >= 5
        && request.resource.data.reply.size() <= 160
        && request.resource.data.projectType is string
        && request.resource.data.projectType.size() <= 80
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 50
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isZenuraAdmin();
    }

    // Mega Kirana — Spark-plan Firestore backend.
    function kiranaMemberPath(storeId, uid) {
      return /databases/$(database)/documents/kiranaStores/$(storeId)/members/$(uid);
    }
    function kiranaIsMember(storeId) {
      return request.auth != null
        && exists(kiranaMemberPath(storeId, request.auth.uid))
        && get(kiranaMemberPath(storeId, request.auth.uid)).data.uid == request.auth.uid
        && get(kiranaMemberPath(storeId, request.auth.uid)).data.active == true;
    }
    function kiranaHasRole(storeId, roles) {
      return kiranaIsMember(storeId)
        && get(kiranaMemberPath(storeId, request.auth.uid)).data.role in roles;
    }
    function kiranaProductPath(storeId, productId) {
      return /databases/$(database)/documents/kiranaStores/$(storeId)/products/$(productId);
    }
    function kiranaCustomerPath(storeId, customerId) {
      return /databases/$(database)/documents/kiranaStores/$(storeId)/customers/$(customerId);
    }
    function kiranaLedgerPath(storeId, customerId, entryId) {
      return /databases/$(database)/documents/kiranaStores/$(storeId)/customers/$(customerId)/ledger/$(entryId);
    }
    function kiranaValidSaleLine(storeId, saleId, data, index) {
      let line = data.items[index];
      let before = get(kiranaProductPath(storeId, line.productId));
      let after = getAfter(kiranaProductPath(storeId, line.productId));
      return line.keys().hasOnly(["productId", "name", "sku", "unit", "quantity", "price", "priceType", "amount"])
        && line.keys().hasAll(["productId", "name", "quantity", "price", "priceType", "amount"])
        && line.productId is string
        && line.quantity is number && line.quantity > 0
        && line.priceType in ["retail", "wholesale"]
        && exists(kiranaProductPath(storeId, line.productId)) && existsAfter(kiranaProductPath(storeId, line.productId))
        && before.data.active == true
        && before.data.stock >= line.quantity
        && line.name == before.data.name
        && line.sku == before.data.sku
        && line.unit == before.data.unit
        && line.price == (line.priceType == "wholesale" ? before.data.wholesalePrice : before.data.retailPrice)
        && line.amount == math.round(line.quantity * line.price * 100) / 100
        && data.stockChanges[line.productId] == line.quantity
        && after.data.stock == before.data.stock - line.quantity
        && after.data.lastSaleId == saleId;
    }
    function kiranaValidSaleLines(storeId, saleId, data) {
      return data.items is list && data.items.size() >= 1 && data.items.size() <= 3
        && data.stockChanges is map
        && data.stockChanges.keys().size() == data.items.size()
        && kiranaValidSaleLine(storeId, saleId, data, 0)
        && (data.items.size() < 2 || kiranaValidSaleLine(storeId, saleId, data, 1))
        && (data.items.size() < 3 || kiranaValidSaleLine(storeId, saleId, data, 2));
    }
    function kiranaValidSaleTotal(data) {
      return data.total == math.round((data.items[0].amount
        + (data.items.size() > 1 ? data.items[1].amount : 0)
        + (data.items.size() > 2 ? data.items[2].amount : 0)) * 100) / 100;
    }
    function kiranaValidSaleCredit(storeId, saleId, data) {
      return data.paymentMode != "credit"
        ? data.customerId == null
        : data.customerId is string
          && exists(kiranaCustomerPath(storeId, data.customerId))
          && get(kiranaCustomerPath(storeId, data.customerId)).data.active == true
          && getAfter(kiranaCustomerPath(storeId, data.customerId)).data.lastLedgerId == saleId
          && getAfter(kiranaCustomerPath(storeId, data.customerId)).data.creditBalance
            == math.round((get(kiranaCustomerPath(storeId, data.customerId)).data.creditBalance + data.total) * 100) / 100
          && getAfter(kiranaLedgerPath(storeId, data.customerId, saleId)).data.type == "credit_sale"
          && getAfter(kiranaLedgerPath(storeId, data.customerId, saleId)).data.amount == data.total;
    }

    // Per-user store registry avoids collection-group queries and their composite-index requirement.
    match /kiranaUsers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["storeIds", "updatedAt"])
        && request.resource.data.storeIds is list
        && request.resource.data.storeIds.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["storeIds", "updatedAt"])
        && request.resource.data.storeIds is list
        && request.resource.data.storeIds.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /kiranaStores/{storeId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["name", "phone", "address", "ownerUid", "status", "currency", "timezone", "createdAt", "updatedAt"])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() <= 250
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.currency == "INR"
        && request.resource.data.timezone == "Asia/Kolkata"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get: if kiranaIsMember(storeId);
      allow list, update, delete: if false;

      match /members/{memberId} {
        allow get: if request.auth != null && memberId == request.auth.uid
          && resource.data.uid == request.auth.uid;
        allow list: if request.auth != null && memberId == request.auth.uid
          && resource.data.uid == request.auth.uid;
        allow create: if request.auth != null && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly(["uid", "role", "active", "permissions", "createdAt"])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == "owner"
          && request.resource.data.active == true
          && request.resource.data.permissions is list
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/kiranaStores/$(storeId)).data.ownerUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /products/{productId} {
        allow get, list: if kiranaIsMember(storeId);
        allow create: if kiranaHasRole(storeId, ["owner", "manager"])
          && request.resource.data.keys().hasOnly(["name", "sku", "unit", "retailPrice", "wholesalePrice", "stock", "lowStockAt", "barcode", "active", "createdBy", "createdAt", "updatedAt"])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
          && request.resource.data.sku is string && request.resource.data.sku.size() <= 40
          && request.resource.data.unit is string && request.resource.data.unit.size() <= 20
          && request.resource.data.retailPrice is number && request.resource.data.retailPrice > 0
          && request.resource.data.wholesalePrice is number && request.resource.data.wholesalePrice > 0
          && request.resource.data.stock is number && request.resource.data.stock >= 0
          && request.resource.data.lowStockAt is number && request.resource.data.lowStockAt >= 0
          && request.resource.data.barcode is string && request.resource.data.barcode.size() <= 80
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if kiranaHasRole(storeId, ["owner", "manager", "cashier"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stock", "lastSaleId", "updatedAt"])
          && request.resource.data.stock is number && request.resource.data.stock >= 0
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastSaleId is string
          && existsAfter(/databases/$(database)/documents/kiranaStores/$(storeId)/sales/$(request.resource.data.lastSaleId))
          && getAfter(/databases/$(database)/documents/kiranaStores/$(storeId)/sales/$(request.resource.data.lastSaleId)).data.createdBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/kiranaStores/$(storeId)/sales/$(request.resource.data.lastSaleId)).data.stockChanges[productId] == resource.data.stock - request.resource.data.stock;
        allow delete: if false;
      }

      match /sales/{saleId} {
        allow get, list: if kiranaIsMember(storeId);
        allow create: if kiranaHasRole(storeId, ["owner", "manager", "cashier"])
          && request.resource.data.keys().hasOnly(["saleId", "invoiceNo", "items", "stockChanges", "subtotal", "tax", "discount", "total", "paymentMode", "customerId", "customerName", "createdBy", "createdAt", "status"])
          && request.resource.data.saleId == saleId
          && request.resource.data.invoiceNo is string
          && request.resource.data.items is list
          && request.resource.data.stockChanges is map
          && request.resource.data.subtotal is number
          && request.resource.data.tax == 0
          && request.resource.data.discount == 0
          && request.resource.data.total is number && request.resource.data.total > 0
          && request.resource.data.subtotal == request.resource.data.total
          && request.resource.data.paymentMode in ["cash", "upi", "card", "credit"]
          && request.resource.data.customerName is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == "completed"
          && kiranaValidSaleLines(storeId, saleId, request.resource.data)
          && kiranaValidSaleTotal(request.resource.data)
          && kiranaValidSaleCredit(storeId, saleId, request.resource.data);
        allow update, delete: if false;
      }

      match /customers/{customerId} {
        allow get, list: if kiranaIsMember(storeId);
        allow create: if kiranaHasRole(storeId, ["owner", "manager", "cashier"])
          && request.resource.data.keys().hasOnly(["name", "phone", "creditBalance", "totalCredit", "totalPaid", "active", "createdBy", "createdAt", "updatedAt"])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
          && request.resource.data.creditBalance == 0
          && request.resource.data.totalCredit == 0
          && request.resource.data.totalPaid == 0
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if kiranaHasRole(storeId, ["owner", "manager", "cashier"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["creditBalance", "totalCredit", "totalPaid", "lastLedgerId", "updatedAt"])
          && request.resource.data.creditBalance is number && request.resource.data.creditBalance >= 0
          && request.resource.data.totalCredit is number && request.resource.data.totalCredit >= resource.data.totalCredit
          && request.resource.data.totalPaid is number && request.resource.data.totalPaid >= resource.data.totalPaid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastLedgerId is string
          && existsAfter(kiranaLedgerPath(storeId, customerId, request.resource.data.lastLedgerId))
          && getAfter(kiranaLedgerPath(storeId, customerId, request.resource.data.lastLedgerId)).data.createdBy == request.auth.uid
          && (
            (getAfter(kiranaLedgerPath(storeId, customerId, request.resource.data.lastLedgerId)).data.type in ["credit_sale", "manual_credit"]
              && request.resource.data.creditBalance == math.round((resource.data.creditBalance + getAfter(kiranaLedgerPath(storeId, customerId, request.resource.data.lastLedgerId)).data.amount) * 100) / 100
              && request.resource.data.totalCredit == math.round((resource.data.totalCredit + getAfter(kiranaLedgerPath(storeId, customerId, request.resource.data.lastLedgerId)).data.amount) * 100) / 100
              && request.resource.data.totalPaid == resource.data.totalPaid)
            ||
            (getAfter(kiranaLedgerPath(storeId, customerId, request.resource.data.lastLedgerId)).data.type == "payment"
              && request.resource.data.creditBalance == math.round((resource.data.creditBalance - getAfter(kiranaLedgerPath(storeId, customerId, request.resource.data.lastLedgerId)).data.amount) * 100) / 100
              && request.resource.data.totalCredit == resource.data.totalCredit
              && request.resource.data.totalPaid == math.round((resource.data.totalPaid + getAfter(kiranaLedgerPath(storeId, customerId, request.resource.data.lastLedgerId)).data.amount) * 100) / 100)
          );
        allow delete: if false;

        match /ledger/{entryId} {
          allow get, list: if kiranaIsMember(storeId);
          allow create: if kiranaHasRole(storeId, ["owner", "manager", "cashier"])
            && request.resource.data.keys().hasOnly(["type", "amount", "invoiceId", "saleId", "mode", "createdBy", "createdAt", "note"])
            && request.resource.data.type in ["credit_sale", "manual_credit", "payment"]
            && request.resource.data.amount is number && request.resource.data.amount > 0
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && getAfter(kiranaCustomerPath(storeId, customerId)).data.lastLedgerId == entryId
            && (
              (request.resource.data.type in ["credit_sale", "manual_credit"] && request.resource.data.invoiceId is string)
              || (request.resource.data.type == "payment" && request.resource.data.mode in ["cash", "upi", "card", "bank"])
            );
          allow update, delete: if false;
        }
      }
    }

  }
}
