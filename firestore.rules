rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isZenuraAdmin() {
      return request.auth != null
        && request.auth.token.email == "sharerohit111@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // ZENURA IGNITE Premium records are server-managed; clients cannot write them.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }
    match /razorpayEvents/{eventId} {
      allow read, write: if false;
    }
    // OAuth states and encrypted broker credentials are server-only; never expose them to browser clients.
    match /upstoxOAuthStates/{stateId} { allow read, write: if false; }
    match /upstoxConnections/{uid} { allow read, write: if false; }
    match /upstoxConnectionControls/{uid} { allow read, write: if false; }
    match /indianMarketStreamLeases/{uid} { allow read, write: if false; }

    // Indian paper-trading balances and orders are server-only; clients use authenticated gateway APIs.
    match /indianMarketWatchlists/{uid} { allow read, write: if false; }
    match /indianPaperAccounts/{uid} { allow read, write: if false; }
    match /indianPaperOrders/{orderId} { allow read, write: if false; }
    match /indianDerivativeOrders/{orderId} { allow read, write: if false; }
    match /indianMarginPreviewLimits/{uid} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }


    // QR/UPI manual payment requests: users may submit their own UTR;
    // only the verified ZENURA admin may review them after checking bank credit.
    match /payments/{paymentId} {
      function validPlan(data) {
        return (data.planKey == "monthly" && data.planLabel == "1 Month" && data.amount == 99 && data.months == 1)
          || (data.planKey == "quarterly" && data.planLabel == "3 Months" && data.amount == 199 && data.months == 3)
          || (data.planKey == "halfyear" && data.planLabel == "6 Months" && data.amount == 399 && data.months == 6)
          || (data.planKey == "yearly" && data.planLabel == "1 Year" && data.amount == 799 && data.months == 12);
      }
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["uid","email","planKey","planLabel","amount","months","utr","status","createdAt"])
        && request.resource.data.keys().hasAll(["uid","email","planKey","planLabel","amount","months","utr","status","createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && validPlan(request.resource.data)
        && request.resource.data.utr is string
        && request.resource.data.utr.matches("^[A-Za-z0-9-]{8,40}$")
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
      allow get, list: if isZenuraAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isZenuraAdmin()
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","reviewedAt","reviewedBy"])
        && request.resource.data.status in ["approved","rejected"]
        && request.resource.data.reviewedBy == request.auth.token.email
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // The user's crypto Premium entitlement is readable by that user,
    // but can only be written by the verified administrator after UTR review.
    match /users/{uid}/private/entitlement {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if isZenuraAdmin()
        && request.resource.data.active is bool
        && request.resource.data.planKey is string
        && request.resource.data.validUntil is timestamp;
      allow delete: if false;
    }

    match /enquiries/{enquiryId} {
      // Public website visitors may submit a validated enquiry only.
      allow create: if
        request.resource.data.keys().hasAll([
          "name", "reply", "projectType", "budget", "message", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "reply", "projectType", "budget", "message", "status", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.reply is string
        && request.resource.data.reply.size() >= 5
        && request.resource.data.reply.size() <= 160
        && request.resource.data.projectType is string
        && request.resource.data.projectType.size() <= 80
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 50
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isZenuraAdmin();
    }
  }
}
