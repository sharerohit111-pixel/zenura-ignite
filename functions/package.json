{
  "name": "zenura-ignite-premium-backend",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "emulate": "firebase emulators:start --only functions,firestore",
    "deploy": "cd .. && test -n \"$FIREBASE_STAGING_PROJECT_ID\" && test \"$FIREBASE_STAGING_PROJECT_ID\" != \"zenura-ignite-technologies\" && firebase deploy --project \"$FIREBASE_STAGING_PROJECT_ID\" --only functions:startUpstoxAuthorization,functions:upstoxOAuthCallback,functions:disconnectUpstoxAccount,functions:getIndianMarketConnectionStatus",
    "deploy:limit-worker": "cd .. && test -n \"$FIREBASE_STAGING_PROJECT_ID\" && test \"$FIREBASE_STAGING_PROJECT_ID\" != \"zenura-ignite-technologies\" && firebase deploy --project \"$FIREBASE_STAGING_PROJECT_ID\" --only functions:processPendingPaperLimitOrders"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  }
}
